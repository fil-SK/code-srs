{
  "expo": {
    "name": "FlipTap",
    "slug": "fliptap-mobile",
    "version": "1.0.0",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "fliptap",
    "ios": {
      "bundleIdentifier": "com.fliptap.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.fliptap.mobile"
    }
  }
}
