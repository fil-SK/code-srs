{
  "name": "code-srs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @itera/web",
    "dev:mobile": "npm run start --workspace @itera/mobile",
    "build": "npm run build --workspace @itera/web",
    "preview": "npm run preview --workspace @itera/web",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mobile": "npm run test --workspace @itera/mobile",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "oxlint": "^1.69.0",
    "playwright": "^1.62.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.9"
  }
}
